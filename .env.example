# App
NODE_ENV=development
APP_NAME=Cypher Admin

# NextAuth / tokens (secrets must be at least 16 chars)
NEXTAUTH_SECRET=change-me-change-me
NEXTAUTH_URL=http://localhost:3000
ACCESS_TOKEN_SECRET=change-me-change-me
REFRESH_TOKEN_SECRET=change-me-change-me
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
BCRYPT_ROUNDS=12

# Primary DB (admin/auth/session data)
PRIMARY_DB_URI=mongodb://localhost:27017/cypher-web

# Bot DB (cypher-v2 data; web never creates indexes here)
# BOT_DB_URI=
# BOT_DB_NAME=

# Sign-up: when false, public sign-up only works while no users exist (first-user bootstrap)
ALLOW_PUBLIC_SIGNUP=false

# Web push (optional)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=
